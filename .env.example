# Environment Variables
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./backend/watersight.db

# Google Cloud OAuth 2.0 Credentials
# 1. Go to https://console.cloud.google.com
# 2. Create a project and setup OAuth Consent Screen
# 3. Create Credentials -> OAuth client ID (Web application)
# 4. Set Authorized redirect URIs to: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Production Configuration (example)
# APP_BASE_URL=https://watersight.example.com
